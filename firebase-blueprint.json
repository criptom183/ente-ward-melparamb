{
  "entities": {
    "WardInfo": {
      "title": "WardInfo",
      "description": "Metadata and Ward Member contact details for Ward 19 Melparamba",
      "type": "object",
      "properties": {
        "wardNumber": { "type": "number", "description": "Ward number (19)" },
        "wardName": { "type": "string", "maxLength": 150, "description": "Ward name in English" },
        "wardNameMl": { "type": "string", "maxLength": 200, "description": "Ward name in Malayalam" },
        "panchayat": { "type": "string", "maxLength": 150, "description": "Panchayat name in English" },
        "panchayatMl": { "type": "string", "maxLength": 200, "description": "Panchayat name in Malayalam" },
        "memberName": { "type": "string", "maxLength": 150, "description": "Ward member full name in English" },
        "memberNameMl": { "type": "string", "maxLength": 200, "description": "Ward member full name in Malayalam" },
        "memberRole": { "type": "string", "maxLength": 150, "description": "Designation in English" },
        "memberRoleMl": { "type": "string", "maxLength": 200, "description": "Designation in Malayalam" },
        "phone": { "type": "string", "maxLength": 20, "description": "Phone number" },
        "whatsapp": { "type": "string", "maxLength": 20, "description": "WhatsApp number" },
        "officeHours": { "type": "string", "maxLength": 200, "description": "Office hours in English" },
        "officeHoursMl": { "type": "string", "maxLength": 250, "description": "Office hours in Malayalam" },
        "officeAddress": { "type": "string", "maxLength": 300, "description": "Office address in English" },
        "officeAddressMl": { "type": "string", "maxLength": 350, "description": "Office address in Malayalam" },
        "photoUrl": { "type": "string", "maxLength": 1000, "description": "Ward member photo URL" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated server timestamp" }
      },
      "required": ["wardNumber", "wardName", "wardNameMl", "panchayat", "panchayatMl", "memberName", "memberNameMl", "phone", "officeHours", "officeHoursMl", "updatedAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Public announcement, event, or job/training notice for Ward 19",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Notice title" },
        "titleMl": { "type": "string", "maxLength": 300, "description": "Notice title in Malayalam" },
        "date": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Display date string" },
        "category": { "type": "string", "enum": ["Meeting", "Camp", "Water/Power", "General", "Job"], "description": "Notice category" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Description" },
        "descriptionMl": { "type": "string", "maxLength": 3000, "description": "Description in Malayalam" },
        "imageUrl": { "type": "string", "maxLength": 500000, "description": "Optional image URL or data URI" },
        "sendPush": { "type": "boolean", "description": "Whether push notification was triggered" },
        "jobType": { "type": "string", "maxLength": 100, "description": "Job/Training type" },
        "eligibility": { "type": "string", "maxLength": 1500, "description": "Eligibility criteria" },
        "lastDate": { "type": "string", "maxLength": 50, "description": "Application deadline" },
        "howToApply": { "type": "string", "maxLength": 1500, "description": "How to apply instructions" },
        "contactPhone": { "type": "string", "maxLength": 25, "description": "Contact phone for application" },
        "driveUrl": { "type": "string", "maxLength": 1000, "description": "Google Drive link to application document" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation server timestamp" }
      },
      "required": ["title", "titleMl", "date", "category", "description", "descriptionMl", "sendPush", "createdAt"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Emergency and civic contact number",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 150, "description": "Contact name" },
        "nameMl": { "type": "string", "maxLength": 200, "description": "Contact name in Malayalam" },
        "role": { "type": "string", "maxLength": 150, "description": "Role or department" },
        "roleMl": { "type": "string", "maxLength": 200, "description": "Role in Malayalam" },
        "phone": { "type": "string", "minLength": 3, "maxLength": 25, "description": "Phone number" },
        "category": { "type": "string", "enum": ["Ward Member", "Panchayat", "Hospital", "Police", "Fire", "Electricity", "Water", "Ambulance"], "description": "Category" },
        "officeHours": { "type": "string", "maxLength": 150, "description": "Available hours" },
        "priority": { "type": "number", "description": "Sort priority" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation server timestamp" }
      },
      "required": ["name", "nameMl", "role", "roleMl", "phone", "category", "officeHours", "priority", "createdAt"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Private citizen complaint containing PII",
      "type": "object",
      "properties": {
        "referenceNumber": { "type": "string", "minLength": 5, "maxLength": 40, "pattern": "^W19-[0-9]{4}-[0-9]{4}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{10}$" },
        "category": { "type": "string", "enum": ["Streetlight", "Road", "Waste", "Drainage", "Water", "Other"] },
        "place": { "type": "string", "minLength": 1, "maxLength": 150 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "photoUrl": { "type": "string", "maxLength": 600000 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "status": { "type": "string", "enum": ["Received", "In Progress", "Resolved"] },
        "adminRemark": { "type": "string", "maxLength": 1000 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referenceNumber", "name", "phone", "category", "place", "description", "status", "adminRemark", "authorUid", "date", "createdAt"]
    },
    "ComplaintPublicStatus": {
      "title": "ComplaintPublicStatus",
      "description": "PII-free public status tracking",
      "type": "object",
      "properties": {
        "referenceNumber": { "type": "string", "minLength": 5, "maxLength": 40, "pattern": "^W19-[0-9]{4}-[0-9]{4}$" },
        "category": { "type": "string", "enum": ["Streetlight", "Road", "Waste", "Drainage", "Water", "Other"] },
        "place": { "type": "string", "minLength": 1, "maxLength": 150 },
        "status": { "type": "string", "enum": ["Received", "In Progress", "Resolved"] },
        "adminRemark": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string", "minLength": 1, "maxLength": 40 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["referenceNumber", "category", "place", "status", "adminRemark", "date", "authorUid", "createdAt"]
    },
    "Scheme": {
      "title": "Scheme",
      "description": "Welfare scheme details",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "titleMl": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "enum": ["Pension", "Housing", "Ration", "Health", "Education", "Agriculture", "Other"] },
        "eligibility": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "eligibilityMl": { "type": "string", "maxLength": 2000 },
        "documentsNeeded": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "documentsNeededMl": { "type": "string", "maxLength": 2000 },
        "howToApply": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "howToApplyMl": { "type": "string", "maxLength": 2000 },
        "formId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "titleMl", "category", "eligibility", "eligibilityMl", "documentsNeeded", "documentsNeededMl", "howToApply", "howToApplyMl", "createdAt"]
    },
    "FormItem": {
      "title": "FormItem",
      "description": "Downloadable application forms and procedures",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 250 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "documentsNeeded": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "type": "string" } },
        "fee": { "type": "string", "maxLength": 100 },
        "officeToSubmit": { "type": "string", "maxLength": 200 },
        "driveUrl": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "description", "documentsNeeded", "steps", "fee", "officeToSubmit", "driveUrl", "createdAt"]
    },
    "EventItem": {
      "title": "EventItem",
      "description": "Community events, camps, and festival calendar",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 250 },
        "category": { "type": "string", "enum": ["ഉത്സവം", "വാക്സിനേഷൻ", "രക്തദാന ക്യാമ്പ്", "യോഗം", "മറ്റുള്ളവ"] },
        "date": { "type": "string", "maxLength": 50 },
        "startTime": { "type": "string", "maxLength": 50 },
        "endTime": { "type": "string", "maxLength": 50 },
        "venue": { "type": "string", "maxLength": 200 },
        "mapsUrl": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "date", "startTime", "endTime", "venue", "description", "createdAt"]
    },
    "GramSabhaMeeting": {
      "title": "GramSabhaMeeting",
      "description": "Ward Gram Sabha schedule, agenda, minutes, and decisions",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "maxLength": 50 },
        "venue": { "type": "string", "maxLength": 200 },
        "agenda": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["വരാനിരിക്കുന്നത്", "കഴിഞ്ഞത്"] },
        "minutesDriveUrl": { "type": "string", "maxLength": 1000 },
        "attendanceCount": { "type": "number" },
        "decisions": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "time", "venue", "agenda", "status", "createdAt"]
    },
    "GramSabhaPoint": {
      "title": "GramSabhaPoint",
      "description": "Resident raised agenda topic for upcoming Gram Sabha",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 25 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 500 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subject", "createdAt"]
    },
    "WasteScheduleItem": {
      "title": "WasteScheduleItem",
      "description": "Haritha Karma Sena waste collection schedule item",
      "type": "object",
      "properties": {
        "wasteType": { "type": "string", "maxLength": 100 },
        "pattern": { "type": "string", "maxLength": 200 },
        "dayOfWeek": { "type": "number" },
        "area": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 1000 },
        "nextDate": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["wasteType", "pattern", "area", "notes", "createdAt"]
    },
    "WasteInfo": {
      "title": "WasteInfo",
      "description": "Haritha Karma Sena contact coordinates",
      "type": "object",
      "properties": {
        "contactName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 25 },
        "whatsapp": { "type": "string", "maxLength": 25 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["contactName", "phone", "whatsapp", "updatedAt"]
    },
    "DevelopmentWork": {
      "title": "DevelopmentWork",
      "description": "Public infrastructure development work progress and expenditure",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 250 },
        "description": { "type": "string", "maxLength": 2500 },
        "category": { "type": "string", "enum": ["റോഡുകൾ", "കുടിവെള്ളം", "തെരുവ് വിളക്കുകൾ", "കെട്ടിടങ്ങൾ", "ശുചിത്വം", "മറ്റുള്ളവ"] },
        "status": { "type": "string", "enum": ["ടെൻഡർ ഘട്ടത്തിൽ", "ആരംഭിച്ചു", "പുരോഗമിക്കുന്നു", "പൂർത്തിയായി"] },
        "startDate": { "type": "string", "maxLength": 50 },
        "expectedEndDate": { "type": "string", "maxLength": 50 },
        "sanctionedAmount": { "type": "number" },
        "spentAmount": { "type": "number" },
        "fundSource": { "type": "string", "maxLength": 150 },
        "progressPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "photoUrls": { "type": "array", "items": { "type": "string" } },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "category", "status", "startDate", "expectedEndDate", "sanctionedAmount", "spentAmount", "fundSource", "progressPercent", "photoUrls", "updates", "createdAt"]
    },
    "BloodDonor": {
      "title": "BloodDonor",
      "description": "Registered voluntary blood donors with consent",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "bloodGroup": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-"] },
        "phone": { "type": "string", "minLength": 10, "maxLength": 15 },
        "area": { "type": "string", "maxLength": 150 },
        "lastDonationDate": { "type": "string", "maxLength": 50 },
        "available": { "type": "boolean" },
        "approved": { "type": "boolean" },
        "consentGiven": { "type": "boolean" },
        "authorUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "bloodGroup", "phone", "area", "available", "approved", "consentGiven", "createdAt"]
    },
    "DirectoryEntry": {
      "title": "DirectoryEntry",
      "description": "Local utility, shop, or institution",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "nameMl": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["Shops", "Doctors", "Electricians", "Plumbers", "Autos", "Anganwadi", "Schools", "Ration Shop"] },
        "phone": { "type": "string", "minLength": 3, "maxLength": 25 },
        "place": { "type": "string", "minLength": 1, "maxLength": 150 },
        "placeMl": { "type": "string", "maxLength": 200 },
        "timings": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "nameMl", "category", "phone", "place", "placeMl", "timings", "createdAt"]
    },
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Authorized administrator account record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name", "createdAt"]
    }
  },
  "firestore": {
    "/ward_info/{docId}": {
      "schema": "WardInfo",
      "description": "Stores Ward 19 Member profile and contact details"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Public announcements and job/training notices"
    },
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Emergency and civic contact directory"
    },
    "/complaints/{referenceId}": {
      "schema": "Complaint",
      "description": "Private citizen complaints containing PII"
    },
    "/complaint_status/{referenceId}": {
      "schema": "ComplaintPublicStatus",
      "description": "Public PII-free status tracking"
    },
    "/schemes/{schemeId}": {
      "schema": "Scheme",
      "description": "Welfare schemes with eligibility and form link"
    },
    "/forms/{formId}": {
      "schema": "FormItem",
      "description": "Official government and panchayat application forms"
    },
    "/events/{eventId}": {
      "schema": "EventItem",
      "description": "Events and camps calendar"
    },
    "/gramSabhas/{meetingId}": {
      "schema": "GramSabhaMeeting",
      "description": "Gram Sabha meetings, agendas, and minutes"
    },
    "/gramSabhaPoints/{pointId}": {
      "schema": "GramSabhaPoint",
      "description": "Resident submitted points for Gram Sabha"
    },
    "/wasteSchedule/{scheduleId}": {
      "schema": "WasteScheduleItem",
      "description": "Haritha Karma Sena waste collection schedule"
    },
    "/wasteInfo/{docId}": {
      "schema": "WasteInfo",
      "description": "Haritha Karma Sena contact coordinates"
    },
    "/works/{workId}": {
      "schema": "DevelopmentWork",
      "description": "Ward 19 development works and progress tracker"
    },
    "/donors/{donorId}": {
      "schema": "BloodDonor",
      "description": "Voluntary blood donors directory"
    },
    "/directory/{entryId}": {
      "schema": "DirectoryEntry",
      "description": "Local community directory"
    },
    "/admins/{adminUid}": {
      "schema": "AdminAccount",
      "description": "Authorized administrators"
    }
  }
}
