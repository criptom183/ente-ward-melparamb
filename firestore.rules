rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives & Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }
    function isSeedId(id) {
      return id is string && id.size() >= 4 && id.size() <= 64 && id.matches('^seed_[a-zA-Z0-9_\\-]+$');
    }
    function isValidRefId(id) {
      return id is string && id.size() >= 5 && id.size() <= 40 && id.matches('^W19-[0-9]{4}-[0-9]{4}$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'muhdRiyu@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // 1. Ward Info (Public Read, Seed or Admin Write)
    match /ward_info/{docId} {
      allow get, list: if true;
      allow create: if isValidId(docId) && (isAdmin() || isSeedId(docId));
      allow update, delete: if isValidId(docId) && isAdmin();
    }

    // 2. Notices (Public Read, Seed or Admin Write)
    match /notices/{noticeId} {
      allow get, list: if true;
      allow create: if isValidId(noticeId) && (isAdmin() || isSeedId(noticeId));
      allow update, delete: if isValidId(noticeId) && isAdmin();
    }

    // 3. Contacts (Public Read, Seed or Admin Write)
    match /contacts/{contactId} {
      allow get, list: if true;
      allow create: if isValidId(contactId) && (isAdmin() || isSeedId(contactId));
      allow update, delete: if isValidId(contactId) && isAdmin();
    }

    // 4. Private Complaints with PII (Resident Create, Owner/Admin Read, Admin Update/Delete)
    match /complaints/{referenceId} {
      allow get, list: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow create: if isValidRefId(referenceId) &&
        incoming().referenceNumber == referenceId &&
        incoming().description is string && incoming().description.size() <= 1500;
      allow update, delete: if isValidRefId(referenceId) && isAdmin();
    }

    // 5. Public Complaint Status & Resolved Issues (PII-Free, Public Read, Atomic Create, Admin Update/Delete)
    match /complaint_status/{referenceId} {
      allow get, list: if true;
      allow create: if isValidRefId(referenceId);
      allow update, delete: if isValidRefId(referenceId) && isAdmin();
    }

    // 6. Schemes (Public Read, Seed or Admin Write)
    match /schemes/{schemeId} {
      allow get, list: if true;
      allow create: if isValidId(schemeId) && (isAdmin() || isSeedId(schemeId));
      allow update, delete: if isValidId(schemeId) && isAdmin();
    }

    // 7. Forms (Public Read, Seed or Admin Write)
    match /forms/{formId} {
      allow get, list: if true;
      allow create: if isValidId(formId) && (isAdmin() || isSeedId(formId));
      allow update, delete: if isValidId(formId) && isAdmin();
    }

    // 8. Events Calendar (Public Read, Seed or Admin Write)
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isValidId(eventId) && (isAdmin() || isSeedId(eventId));
      allow update, delete: if isValidId(eventId) && isAdmin();
    }

    // 9. Gram Sabhas (Public Read, Seed or Admin Write)
    match /gramSabhas/{meetingId} {
      allow get, list: if true;
      allow create: if isValidId(meetingId) && (isAdmin() || isSeedId(meetingId));
      allow update, delete: if isValidId(meetingId) && isAdmin();
    }

    // 10. Gram Sabha Points (Resident Create, Admin Read/Manage)
    match /gramSabhaPoints/{pointId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(pointId) &&
        incoming().subject is string &&
        incoming().subject.size() >= 1 &&
        incoming().subject.size() <= 500;
      allow update, delete: if isValidId(pointId) && isAdmin();
    }

    // 11. Waste Schedule (Public Read, Seed or Admin Write)
    match /wasteSchedule/{scheduleId} {
      allow get, list: if true;
      allow create: if isValidId(scheduleId) && (isAdmin() || isSeedId(scheduleId));
      allow update, delete: if isValidId(scheduleId) && isAdmin();
    }

    // 12. Waste Info (Public Read, Seed or Admin Write)
    match /wasteInfo/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(docId) && (isAdmin() || isSeedId(docId));
    }

    // 13. Development Works (Public Read, Seed or Admin Write)
    match /works/{workId} {
      allow get, list: if true;
      allow create: if isValidId(workId) && (isAdmin() || isSeedId(workId));
      allow update, delete: if isValidId(workId) && isAdmin();
    }

    // 14. Blood Donors (Approved Donors Public Read, Resident Register with consent, Admin Manage)
    match /donors/{donorId} {
      allow get, list: if resource.data.approved == true || isAdmin();
      allow create: if isValidId(donorId) &&
        incoming().consentGiven == true &&
        (incoming().approved == false || isAdmin() || isSeedId(donorId));
      allow update, delete: if isValidId(donorId) && isAdmin();
    }

    // 15. Directory (Public Read, Seed or Admin Write)
    match /directory/{entryId} {
      allow get, list: if true;
      allow create: if isValidId(entryId) && (isAdmin() || isSeedId(entryId));
      allow update, delete: if isValidId(entryId) && isAdmin();
    }

    // 16. Admins (Authenticated Self or Admin Read, Admin Write)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create, update, delete: if isSignedIn() && isAdmin();
    }
  }
}
